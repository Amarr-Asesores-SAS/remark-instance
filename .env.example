# ---------------------------------------------------------------------------
# Remark42 - instancia self-hosted para estrellaswebcam.com
# Copia este archivo a .env y rellena SECRET y ADMIN_PASSWD.
# .env esta en .gitignore: nunca se commitea.
# ---------------------------------------------------------------------------

# URL publica tal como la ve el navegador. El frontend (Astro) sirve todo bajo
# su propio dominio y hace rewrite de /comments/* -> https://comments.ewcam.co/*
# (server-side). Por eso REMARK_URL apunta al dominio del frontend + subpath,
# NO a comments.ewcam.co. Es el unico valor acoplado al frontend.
REMARK_URL=https://estrellaswebcam.com/comments

# Identificador del sitio. El frontend usa el mismo en site=...
SITE=estrellaswebcam

# Clave de firma de los JWT.  Generar con:  openssl rand -hex 32
SECRET=

# Password para el usuario 'admin' (HTTP basic auth) en /api/v1/admin/*
ADMIN_PASSWD=

# --- Autenticacion -------------------------------------------------------
# Solo anonimo: el usuario escribe un nombre, sin OAuth, sin pantalla de login.
AUTH_ANON=true

# --- Email del admin para recibir notificaciones ----------------
ADMIN_SHARED_EMAIL=loquesea@estrellaswebcam.com

# --- Votos -------------------------------------------------------------
ANON_VOTE=true          # permitir votar a usuarios anonimos
VOTES_IP=true           # deduplicar por IP (obligatorio con ANON_VOTE)
VOTES_IP_TIME=0         # 0 = 1 voto por IP y comentario, permanente (cambiar de
                        #     sentido ▲<->▼ si se permite; repetir el mismo no)

# --- Limites de contenido -------------------------------------------------
MAX_COMMENT_SIZE=2000
IMAGE_MAX_SIZE=1000000  # 1 MB por imagen (si se habilita subida desde el front)
IMAGE_RESIZE_WIDTH=1200
IMAGE_RESIZE_HEIGHT=800

# --- Red / TLS / proxy --------------------------------------------------
SSL_TYPE=none                  # el TLS lo hace el nginx del host
TRUSTED_PROXY=172.16.0.0/12    # rango desde el que llega el proxy (bridge docker).
                               # Ajustar si `docker network inspect ewcam-remark_default`
                               # muestra otra subred. Necesario para que rate-limit
                               # y VOTES_IP usen la IP real (X-Forwarded-For).

# --- Operacion --------------------------------------------------------
DEBUG=false
EMOJI=false
